{
  "name": "elith-tui",
  "version": "1.0.0",
  "type": "module",
  "description": "Elith Terminal UI - TypeScript/Ink implementation",
  "main": "dist/index.js",
  "bin": {
    "elith-tui": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cli",
    "tui",
    "terminal",
    "ink",
    "react"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "diff": "^5.1.0",
    "eventsource": "^2.0.2",
    "figlet": "^1.7.0",
    "ink": "^4.4.1",
    "ink-select-input": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "unicode-animations": "^1.0.3"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/figlet": "^1.5.8",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
